# Bloomberg Bozo - API Keys Configuration
# Copy this file to .env and fill in your API keys
# The app works in demo mode without any keys (uses realistic mock data)

# Finnhub - Real-time stocks, forex, news
# Free tier: 60 API calls/minute
# Register: https://finnhub.io/register
VITE_FINNHUB_API_KEY=

# Alpha Vantage - Historical data, technical indicators, forex
# Free tier: 25 API requests/day
# Register: https://www.alphavantage.co/support/#api-key
VITE_ALPHA_VANTAGE_API_KEY=

# Financial Modeling Prep - Fundamentals, income statements
# Free tier: 250 API requests/day
# Register: https://site.financialmodelingprep.com/developer
VITE_FMP_API_KEY=

# FRED (Federal Reserve Economic Data) - Economic indicators
# Free tier: Very generous limits
# Register: https://fred.stlouisfed.org/docs/api/api_key.html
VITE_FRED_API_KEY=

# Note: CoinGecko (crypto data) requires NO API key
# Note: Marketaux (financial news) requires NO API key for basic access
